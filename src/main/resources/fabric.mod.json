{
	"schemaVersion": 1,
	"id": "morphmod",
	"version": "${version}",
	"name": "Morph",
	"description": "Transform into any mob: take its shape, its stats and its powers.",
	"authors": ["TakumiStudios"],
	"contact": {
		"homepage": "https://github.com/AloneX15/morph-mod",
		"sources": "https://github.com/AloneX15/morph-mod",
		"issues": "https://github.com/AloneX15/morph-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/morphmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["com.takumistudios.morphmod.MorphMod"],
		"client": ["com.takumistudios.morphmod.client.MorphModClient"]
	},
	"mixins": [
		"morphmod.mixins.json",
		{
			"config": "morphmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=25",
		"fabric-api": "*",
		"geckolib": ">=5.5"
	},
	"suggests": { "luckperms": "*" }
}
